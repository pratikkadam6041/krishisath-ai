# ============================================================
# KrishiSarth AI - Environment Variables
# Copy to .env and fill in for production
# ============================================================

# --- Authentication ---
# Backend OTP (recommended production): deploy thin API for Twilio/SMS
VITE_API_BASE_URL=https://your-api.krishisarth.in

# Firebase Phone Auth (alternative to API_BASE_URL)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Dev only: allow demo OTP 204681 when no provider configured
VITE_ALLOW_DEMO_AUTH=false

# --- Live Mandi (data.gov.in Agmarknet) ---
VITE_DATA_GOV_API_KEY=

# --- MQTT / Sensors ---
VITE_MQTT_BROKER_URL=wss://your-broker:8884/mqtt
VITE_MQTT_CLIENT_ID_PREFIX=krishisarth_web_

# --- InfluxDB (sensor history) ---
VITE_INFLUX_URL=https://influx.your-domain.com
VITE_INFLUX_TOKEN=
VITE_INFLUX_ORG=krishisarth
VITE_INFLUX_BUCKET=farm_data

# --- KisanAI (Gemini) ---
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash-lite

# --- Krishi Realtime Voice (server-side only: never prefix with VITE_) ---
OPENAI_API_KEY=

# --- Plant.id disease API (optional, scanner) ---
VITE_PLANT_ID_API_KEY=

# --- App ---
VITE_APP_VERSION=2.0.0
VITE_DEALER_PIN=123456
